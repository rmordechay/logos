main() {
    vec1 = Vec3(2.34, Vec2(3.71, 8.34))
    print(vec1)
    vec2 = Vec3(4.24, 6.24, 5.54)
    print(vec1 + 3)
    print(vec1 - 3)
    print(vec1 * 3)
    print(vec1 / 3)
    print(vec1 + vec2)
    print(vec1 - vec2)
    print(vec1 * vec2)
    print(vec1 x vec2)
    print(Vec2() x Vec2())
}
