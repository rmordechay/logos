object Obj {
    x: Int?
}

func(str: Str?, number: Int?) {
    print(str)
    print(number)
}

nulls() {
    func("text1", 3)
    print("--")
    func("text2", null)
    print("--")
    func(null, 45)
    print("--")
    func(null, null)
}

nulls2() {
    a: Int? = null
    b = 3?
    print(a + b)
    a := 2
    print(a + b)

    func("Roi", null)
    func(null, null)
    func(null, 2)
}

main() {
    a = 2?
    print(a)
    a := null
    print(a)
    obj = Obj{x = 2}?
    //obj = Obj{x = 2}
    print(obj.x)


    arr = [1, 2, 3]
    if arr[0] == null {
        print(arr)
    }
    if null == null {
        print(arr)
    }
    a = 2
    if a == null {
        print(a)
    }
}