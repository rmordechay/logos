object Obj2 {
    x: Int
}

object Obj {
    obj2: Obj2
}

main() {
    // Var Int
    a = 2
    a := 4454
    a++
    a--
    a += 2
    a -= 3

    // SArray Int
    arr: Int[2]!
    arr[0] := 354
    arr[1] := 34
    print(arr[0])
    print(arr[1])

    // Selection
    obj = Obj{}
    obj.obj2 := Obj2{}
    obj.obj2.x := 75
    print(obj.obj2.x)

    // Vector
    vec = vec4(0.23, 0.238, 0.085, 0.54)
    vec.x := 0.12
    print(vec.x)
}
