object Obj1 {
    obj3: Obj3
}

object Obj2 {
    owner obj3: Obj3
}

object Obj3 {
    name: Str
}

main() {
    obj3 = Obj3{name = "Obj3"}
    func1(obj3)
}

func1(obj3: Obj3) {
    obj1 = Obj1{obj3 = obj3}
    func2(obj1.obj3)
}

func2(obj3: Obj3) {
    obj2 = Obj2{obj3 = obj3}
    print(obj2.obj3.name)
}
