object Parent {
    id: Int
    child: Child
}

object Child {
    id: Int
}

func(parent: Parent) {
    child1 = Child{id=23}
    if true {
        parent.child := child1
    }
}

main() {
    child1 = Child{id=23}
    parent1 = Parent{id=1, child=child1}
    print(parent1.child.id)
    func(parent1)
    print(parent1.child.id)
}
