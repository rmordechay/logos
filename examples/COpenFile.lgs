import C "stdio.h"

main() {
    writeFile()
    readFile()
}

writeFile() {
    file = fopen("../test.txt", "w")
    fseek(file, 0, SEEK_END)
    length = ftell(file)
    print("File length: ${length}")
    fseek(file, 0, SEEK_SET)
    fprintf(file, "Hello world")
    fclose(file)
}

readFile() {
    file = fopen("../test.txt", "r")
    buffer: Char[1024]
    lineRead = fgets(buffer, 1024, file)
    print(buffer)
    fclose(file)
}
