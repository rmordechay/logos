object Obj {
    pub const x: Int
    y: Int

    pub make() {
        print(2)
    }

    pub openFile() {
        print("opening file")
    }

    pub closeFile() {
        print("closing file")
    }

    io {
        openFile
        closeFile
    }
}

main() {
    obj = Obj{x = 34}
    Obj.make()
    io file = obj.openFile() {
        line = file.readLine()
        print(line)
    }
}
