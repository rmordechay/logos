object Obj {
    pub const x: Int
    y: Int

    io(openFile, closeFile)

    pub make2(x: Obj) {
        print(2)
    }

    pub make() {
        print(2)
    }

    pub openFile() {
        print("opening file")
    }

    pub closeFile() {
        print("closing file")
    }
}

main() {
    obj = Obj{x = 34}
    Obj.make()
    io obj.openFile() {
        print("hello")
    }
}
