main() {
    a = ["roi", "adi"]!
    b = ["roi", "adi"]
    c = vec2(1, 2)
    c.x := 2.0
    c.y := 4.0
    d = "roi"
    print(a[0])
    print(b[0])
    print(c[0])
    print(d[0])
    if "roi" in a {
        print("roi in a")
    }
    if "roi" in b {
        print("roi in b")
    }
    if 1 in c {
        print("1 in c")
    }
    if "r" in d {
        print("r in d")
    }
    print(c * 2)
    print(c / 2)
    print(c + vec2(1, 2))
    print(c - vec2(1, 2))
}

iter() {
    arr: Float[] = [3.23, 6.543, 14.243]
    for i in arr {
        print(i)
    }

    sarr: Float[3] = [3.23, 6.543, 14.243]
    for i in sarr {
        print(i)
    }

    vec3: Vec3 = Vec3(3.23, 6.543, 14.243)
    for i in vec3 {
        print(i)
    }

    set: Set<Float> = Set[3.23, 6.543, 14.243, 14.243]
    for i in set {
        print(i)
    }

    map2: {Str: {Str: {Str: Int[]}}}
    map2["Roi"] := {"Roi1": {"Roi2": [1, 2]}}
    for i in map2["Roi"]["Roi1"]["Roi2"] {
        print(i)
    }
}
