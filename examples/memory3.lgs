object Obj1 {
    obj2: Obj2
}

object Obj2 {
    obj3: Obj3
}

object Obj3 {
    obj4: Obj4
}

object Obj4 {
    id: Int
    name: Str
}

func(obj1: Obj1) {
    for 100_000 {
        obj1.obj2 := Obj2{obj3=Obj3{obj4=Obj4{id=5, name="Roi"}}}
    }
}

main() {
    obj1 = Obj1{obj2=Obj2{obj3=Obj3{obj4=Obj4{id=3}}}}
    //print(obj1)
    func(obj1)
    //print(obj1)
}
